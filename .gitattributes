# Binary artifacts: never touch their bytes (a package's sha256/keccak256 is its identity).
*.wasm binary
*.onnx binary
*.safetensors binary

# The engine build inputs (crate, lock, toolchain pin, script) must check out byte-identical
# on every OS, and the shell scripts must run under bash on Linux.
float_runtime/engine/** text eol=lf
*.sh text eol=lf
*.py text eol=lf
float_runtime/testdata/*.json text eol=lf
